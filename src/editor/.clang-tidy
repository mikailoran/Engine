---
# The root's checks, minus those that fight Qt's own idioms, plus every
# clazy Qt check. Clazy needs -load ClazyClangTidy.so.
# compare-member-check crashes clang-tidy 22 (clazy 1.17) on main_window.cpp.
InheritParentConfig: true
Checks: >
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -readability-redundant-access-specifiers,
  clazy-*,
  -clazy-qt-keywords,
  -clazy-qt-keyword-emit,
  -clazy-sanitize-inline-keyword,
  -clazy-compare-member-check

CheckOptions:
  # signals, slots and emit have no public header to include.
  misc-include-cleaner.IgnoreHeaders: 'QtCore/qtmetamacros\.h'
