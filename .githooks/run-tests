#!/usr/bin/env bash
#
# Shared gate for the hooks in this directory: build the unit tests, then run
# them. Exits non-zero to abort the git operation that invoked it.
#
# Build directory defaults to build/Debug (see CLAUDE.md); override with
# ENGINE_HOOK_BUILD_DIR. Set ENGINE_SKIP_HOOK_TESTS=1 to bypass entirely --
# needed for `git rebase`, which has no --no-verify.
#
# Hooks run with the working directory at the top level of the worktree, so the
# relative build path below resolves correctly regardless of where git was run.

set -o errexit -o nounset -o pipefail

readonly HOOK_NAME="${1:-hook}"
readonly BUILD_DIR="${ENGINE_HOOK_BUILD_DIR:-build/Debug}"

# Explicit opt-out, checked before anything expensive happens.
if [[ -n "${ENGINE_SKIP_HOOK_TESTS:-}" ]]; then
    echo "[${HOOK_NAME}] ENGINE_SKIP_HOOK_TESTS set -- skipping unit tests."
    exit 0
fi

# An absent build tree means we cannot verify anything; fail loudly rather than
# letting the operation through unchecked.
if [[ ! -f "${BUILD_DIR}/CMakeCache.txt" ]]; then
    echo "[${HOOK_NAME}] No configured build tree at ${BUILD_DIR}." >&2
    echo "[${HOOK_NAME}] Run: cmake -S . -B ${BUILD_DIR} -DCMAKE_BUILD_TYPE=Debug" >&2
    echo "[${HOOK_NAME}] Or set ENGINE_SKIP_HOOK_TESTS=1 to bypass." >&2
    exit 1
fi

# Rebuild first: ctest would otherwise happily run a stale binary, and
# gtest_discover_tests only refreshes the test list at build time.
echo "[${HOOK_NAME}] Building ecs_tests in ${BUILD_DIR}..."
cmake --build "${BUILD_DIR}" --target ecs_tests

echo "[${HOOK_NAME}] Running unit tests..."
ctest --test-dir "${BUILD_DIR}" --output-on-failure

echo "[${HOOK_NAME}] Unit tests passed."
