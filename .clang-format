# Google style, but short ifs and loops always break onto their own line.
BasedOnStyle: Google
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
# Google's categories, plus Jolt.h sorted first: other Jolt headers need it
IncludeCategories:
  - Regex: '^<ext/.*\.h>'
    Priority: 2
    SortPriority: 4
  - Regex: '^<Jolt/Jolt\.h>'
    Priority: 1
    SortPriority: 1
  - Regex: '^<.*\.h>'
    Priority: 1
    SortPriority: 2
  - Regex: '^<.*'
    Priority: 2
    SortPriority: 4
  - Regex: '.*'
    Priority: 3
    SortPriority: 5
