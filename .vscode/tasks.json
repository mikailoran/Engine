{
	"version": "2.0.0",
	"tasks": [
		{
			// clangd only lints open files; this lints all of src/ and tests/.
			"label": "lint: project",
			"type": "shell",
			"command": "\"${workspaceFolder}/tools/lint.sh\" -p \"${command:cmake.buildDirectory}\" full",
			"problemMatcher": {
				"owner": "clang-tidy",
				"source": "clang-tidy",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+):(\\d+):(\\d+): (warning|error): (.*?)(?: \\[([^\\]]+)\\])?$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5,
					"code": 6
				}
			}
		},
		{
			// Only lines changed since the branch left main, committed or not.
			// Shares the owner above, so each run replaces the other's results.
			"label": "lint: changes",
			"type": "shell",
			"command": "\"${workspaceFolder}/tools/lint.sh\" -p \"${command:cmake.buildDirectory}\" diff",
			"problemMatcher": {
				"owner": "clang-tidy",
				"source": "clang-tidy",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+):(\\d+):(\\d+): (warning|error): (.*?)(?: \\[([^\\]]+)\\])?$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5,
					"code": 6
				}
			}
		}
	]
}
